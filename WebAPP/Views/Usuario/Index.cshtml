@{
    ViewData["Title"] = "Administración";
}

<div class="container mt-5">
<h1 class="mb-4">Administración</h1>


    <div class="d-flex flex-column align-items-start gap-3">

        <a asp-controller="Usuario" asp-action="Create"
           class="btn btn-primary">
            Crear usuario
        </a>

        <a asp-controller="Historia" asp-action="Create"
           class="btn btn-primary">
            Crear historia
        </a>

        <a asp-controller="Capitulo" asp-action="SeleccionarHistoria"
           class="btn btn-primary">
            Crear capítulo
        </a>

        <a asp-controller="Historia" asp-action="Index"
           class="btn btn-secondary">
            Ver historias
        </a>

        <a asp-controller="Auditoria" asp-action="Index"
           class="btn btn-secondary">
            Ver auditorías
        </a>

        <form asp-controller="Usuario" asp-action="Logout" method="post"
              class="mt-3">
            <button type="submit" class="btn btn-danger">
                Cerrar sesión
            </button>
        </form>

    </div>

</div>