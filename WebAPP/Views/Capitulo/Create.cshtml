@model DTOs.DTOs.CapituloAltaDTO

<h1>Agregar capítulo</h1>

<form asp-action="Create" method="post">

    <input type="hidden" asp-for="HistoriaId" />

    <div class="form-group">
        <label>Capítulo antecedente</label>

        <select name="CapituloAntecedenteId" class="form-control">
            <option value="">Seleccione un capitulo</option>

            @foreach (var ante in ViewBag.Antecedentes)
            {
                <option value="@ante.CapId">@ante.CapTitulo</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label>Tipo</label>

        <select asp-for="Tipo" class="form-control">
            <option value="1">Intermedio</option>
            <option value="2">Final</option>
        </select>
    </div>

    <div class="form-group">
        <label>Título</label>
        <input asp-for="Titulo" class="form-control" />
    </div>

    <div class="form-group">
        <label>Texto</label>
        <textarea asp-for="Texto" class="form-control"></textarea>
    </div>

    <div class="form-group">
        <label>Texto de opción</label>
        <input asp-for="TextoOpcion" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Agregar capítulo
    </button>

</form>
