@using DTOs.DTOs
@model List<CategoriaDTO>

<h1>Alta historia</h1>

<form asp-action="Create" method="post">

<label for="Titulo">Título</label>
<input type="text" name="Titulo" id="Titulo"/>

<label for="Sinopsis">Sinopsis</label>
<input type="text" name="Sinopsis" id="Sinopsis" />

@foreach(CategoriaDTO dto in Model)
{
        <label>
            @dto.Nombre
            <input type="checkbox"
                   name="CategoriasId"
                   value="@dto.Id" />
        </label>
}

    <label for="TituloCapInicial">Titulo capitulo inicial: </label>
    <input type="text" name="TituloCapInicial" id="TituloCapInicial" />

    <label for="TextoCapInicial">Texto capitulo inicial: </label>
    <input type="text" name="TextoCapInicial" id="TextoCapInicial" />

<input type="submit" value="Crear"/>

</form>