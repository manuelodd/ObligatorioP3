@using DTOs.DTOs
@model List<DTOs.DTOs.HistoriaDTO>

@{
    ViewData["Title"] = "Historias";
}

@if (TempData["Error"] != null)
{
    <p>@TempData["Error"]</p>
}

@if (TempData["Mensaje"] != null)
{
    <p>@TempData["Mensaje"]</p>
}

<h1>Lista de historias</h1>

<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>Titulo</th>
            <th>Sinopsis</th>
        </tr>
    </thead>

    <tbody>
        @foreach (HistoriaDTO dto in Model)
        {
            <tr>
                <td>@dto.Id</td>
                <td>@dto.Titulo</td>
                <td>@dto.Sinopsis</td>
                
                <td> <a asp-controller="Historia" asp-action="Edit" asp-route-id="@dto.Id">Editar</a></td>
            </tr>
        }
    </tbody>
</table>

